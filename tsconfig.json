{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@showscout/shared": ["./packages/shared/src/index.ts"],
      "@showscout/scoring": ["./packages/scoring/src/index.ts"],
      "@showscout/providers": ["./packages/providers/src/index.ts"],
      "@showscout/providers/*": ["./packages/providers/src/*"]
    }
  },
  "include": ["apps", "packages", "scripts"]
}
